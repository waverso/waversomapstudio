      <AdditionalDependencies>plugin_d.lib;d3d9.lib;ole32.lib;windowscodecs.lib;winhttp.lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(PLUGIN_SDK_DIR)\output\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <ImportLibrary>.build\bin\GTA-SA\Debug\$(ModName).lib</ImportLibrary>
    </Link>
    <PostBuildEvent>
      <Command>
if defined GTA_SA_DIR ( 

taskkill /IM gta_sa.exe /F /FI "STATUS eq RUNNING" 

xcopy /Y "$(TargetPath)" "$(GTA_SA_DIR)\scripts" 

)</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <PropertyGroup>
    <StudioInfoVersionFile>$(ProjectDir)version.txt</StudioInfoVersionFile>
    <StudioInfoVersionDirectory>$(ProjectDir).build\generated\$(Configuration)\</StudioInfoVersionDirectory>
    <StudioInfoVersionHeader>$(StudioInfoVersionDirectory)studio_info_version.generated.h</StudioInfoVersionHeader>
  </PropertyGroup>
  <Target Name="GenerateStudioInfoVersion" BeforeTargets="ClCompile" Inputs="$(StudioInfoVersionFile);$(MSBuildProjectFullPath)" Outputs="$(StudioInfoVersionHeader)">
    <ReadLinesFromFile File="$(StudioInfoVersionFile)">
      <Output TaskParameter="Lines" ItemName="StudioInfoVersionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <StudioInfoVersion>@(StudioInfoVersionLines)</StudioInfoVersion>
    </PropertyGroup>
    <Error Condition="'$(StudioInfoVersion)' == ''" Text="version.txt must contain a version on its first line." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(StudioInfoVersion)', '^[0-9]+[.][0-9]+([.][0-9]+)?$')) != 'True'" Text="version.txt must contain a numeric version with two or three components." />
    <MakeDir Directories="$(StudioInfoVersionDirectory)" />
    <ItemGroup>
      <StudioInfoVersionHeaderLine Include="repository">
        <Text>// Source Repository: https://github.com/waverso/waversomapstudio
</Text>
      </StudioInfoVersionHeaderLine>
      <StudioInfoVersionHeaderLine Include="pragma">
        <Text>#pragma once</Text>
      </StudioInfoVersionHeaderLine>
      <StudioInfoVersionHeaderLine Include="namespace">
        <Text>namespace StudioInfo</Text>
      </StudioInfoVersionHeaderLine>
      <StudioInfoVersionHeaderLine Include="open">
        <Text>{</Text>
      </StudioInfoVersionHeaderLine>
      <StudioInfoVersionHeaderLine Include="version">
        <Text>    inline constexpr char Version[] = "$(StudioInfoVersion)";</Text>
      </StudioInfoVersionHeaderLine>
      <StudioInfoVersionHeaderLine Include="close">
        <Text>}</Text>
      </StudioInfoVersionHeaderLine>
    </ItemGroup>
    <WriteLinesToFile File="$(StudioInfoVersionHeader)" Lines="@(StudioInfoVersionHeaderLine->'%(Text)')" Overwrite="true" Encoding="ASCII" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>